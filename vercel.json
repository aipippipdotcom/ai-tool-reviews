{
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "src": "/sitemap\\.xml", "dest": "/api/sitemap" },
    { "src": "/", "dest": "/api/post-meta?path=/" },
    { "src": "/(categories|about)/?", "dest": "/api/post-meta?path=/$1" },
    { "src": "/post/([^/]+)/?", "dest": "/api/post-meta?path=/post/$1" },
    { "src": "/category/([^/]+)/?", "dest": "/api/post-meta?path=/category/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
