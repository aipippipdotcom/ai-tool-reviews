{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.aipippip.net" }],
      "destination": "https://aipippip.net/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
